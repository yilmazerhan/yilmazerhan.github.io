# ─── Database ────────────────────────────────────────────────────────────────
POSTGRES_DB=teamapp
POSTGRES_USER=teamapp
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_PORT=5432

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# ─── Application ─────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_64_CHAR_RANDOM_HEX_STRING

# IMPORTANT: Each key MUST be unique — reusing keys across services reduces security.
# Generate each with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
JIRA_ENCRYPTION_KEY=CHANGE_ME_UNIQUE_FERNET_KEY_1
SMTP_ENCRYPTION_KEY=CHANGE_ME_UNIQUE_FERNET_KEY_2
SSL_ENCRYPTION_KEY=CHANGE_ME_UNIQUE_FERNET_KEY_3
INVENTORY_ENCRYPTION_KEY=CHANGE_ME_UNIQUE_FERNET_KEY_4

# ─── URLs ────────────────────────────────────────────────────────────────────
# Set to your server's domain or IP (no trailing slash)
FRONTEND_URL=https://YOUR_DOMAIN_OR_IP
BACKEND_URL=https://YOUR_DOMAIN_OR_IP/api
ENVIRONMENT=production

# ─── Rate Limits (production defaults) ───────────────────────────────────────
AUTH_LOGIN_RATE_LIMIT=5/minute
AUTH_FORGOT_PASSWORD_RATE_LIMIT=3/hour
AUTH_REFRESH_RATE_LIMIT=60/minute

# ─── SuperAdmin seed (first startup only) ────────────────────────────────────
SUPERADMIN_EMAIL=admin@example.com
SUPERADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
SUPERADMIN_FULL_NAME=System Administrator

# ─── SSL ─────────────────────────────────────────────────────────────────────
# Self-signed certificate is generated automatically on first start.
# To use your own certificate, upload via the admin UI (Settings → SSL).
#
# Add extra Subject Alternative Names to the self-signed cert (comma-separated).
# Use this to add your server's real IP or hostname so TLS validation works.
# Example: SSL_EXTRA_SANS=IP:10.20.41.54,DNS:myserver.example.com
SSL_EXTRA_SANS=
