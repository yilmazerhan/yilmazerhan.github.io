# ─── Database ────────────────────────────────────────────────────────────────
POSTGRES_DB=teamapp
POSTGRES_USER=teamapp
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# ─── Application ─────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_64_CHAR_RANDOM_HEX_STRING

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
JIRA_ENCRYPTION_KEY=CHANGE_ME_FERNET_KEY
SMTP_ENCRYPTION_KEY=CHANGE_ME_FERNET_KEY
SSL_ENCRYPTION_KEY=CHANGE_ME_FERNET_KEY

# ─── URLs ────────────────────────────────────────────────────────────────────
FRONTEND_URL=https://localhost
BACKEND_URL=https://localhost/api
ENVIRONMENT=development

# ─── SuperAdmin seed (first startup only) ────────────────────────────────────
SUPERADMIN_EMAIL=admin@example.com
SUPERADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
SUPERADMIN_FULL_NAME=System Administrator

# ─── SSL ─────────────────────────────────────────────────────────────────────
# Self-signed certificate is generated automatically on first start.
# To use your own certificate, upload via the admin UI.
SSL_CERT_PATH=/etc/nginx/ssl/current.crt
SSL_KEY_PATH=/etc/nginx/ssl/current.key
